{
  "name": "{{slug}}",
  "version": "0.0.0",
  "private": true,
  "description": "{{description}}",
  "author": "{{holder}}",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "format:check": "oxfmt --check && prettier --check --log-level warn \"**/*.md\"",
    "format:fix": "oxfmt && prettier --write --log-level warn \"**/*.md\"",
    "lint:check": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "prepare": "node .githooks/install.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "verify": "pnpm format:check && pnpm lint:check && pnpm build && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=12.16.1 <13"
  },
  "packageManager": "pnpm@12.16.1"
}
