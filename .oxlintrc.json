{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    // project:start
    // Project patterns. Blocks open their list so the template's last entry keeps no trailing comma.
    // project:end
    "**/dist/**",
    "**/coverage/**",
    "**/test-results/**",
    "**/playwright-report/**"
  ],
  "env": {
    "browser": true,
    "node": true
  },
  "plugins": ["typescript", "oxc", "jsdoc", "unicorn", "promise", "vitest"],
  "rules": {
    // project:start
    // Rules the template does not set. A later duplicate key wins, so a rule the template sets
    // changes in the template.
    // project:end
    "curly": ["error", "all"],
    "eqeqeq": ["error", "always"],
    "jsdoc/check-access": "error",
    "jsdoc/check-property-names": "error",
    "jsdoc/check-tag-names": "off",
    "jsdoc/empty-tags": "error",
    "jsdoc/implements-on-classes": "error",
    "jsdoc/no-defaults": "error",
    "jsdoc/require-param-description": "error",
    "jsdoc/require-param-name": "error",
    "jsdoc/require-property-description": "error",
    "jsdoc/require-property-name": "error",
    "jsdoc/require-returns-description": "error",
    "jsdoc/require-throws-description": "error",
    "no-await-in-loop": "error",
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-empty": "error",
    "no-empty-function": "off",
    "no-var": "error",
    "prefer-const": "error",
    "promise/prefer-await-to-then": "error",
    "typescript/consistent-type-imports": ["error", { "prefer": "type-imports" }],
    "typescript/no-explicit-any": "error",
    "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "vitest/no-identical-title": "error",
    "vitest/require-mock-type-parameters": "off"
  },
  "overrides": [
    // project:start
    // Project overrides, such as console output in a CLI's entry files. A later override wins, so
    // the template's overrides below take precedence where both set the same rule.
    // project:end
    {
      "files": [".githooks/**", "**/scripts/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
